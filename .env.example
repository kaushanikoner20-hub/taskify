# Copy this file to .env before running `docker compose up --build`

# Postgres
POSTGRES_DB=taskify
POSTGRES_USER=taskify_user
POSTGRES_PASSWORD=change_me_in_production

# Backend
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Ports (host side)
FRONTEND_PORT=3000
BACKEND_PORT=4000